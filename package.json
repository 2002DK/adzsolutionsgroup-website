{
  "name": "adz-solutions-site",
  "private": true,
  "version": "1.0.0",
  "description": "ADZ Solutions website and employee portal — Cypress E2E test scaffold",
  "scripts": {
    "serve": "http-server . -p 5500 -c-1 --silent",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:e2e": "start-server-and-test serve http://localhost:5500 cy:run",
    "test:e2e:open": "start-server-and-test serve http://localhost:5500 cy:open"
  },
  "devDependencies": {
    "cypress": "^13.15.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^2.0.8"
  }
}
